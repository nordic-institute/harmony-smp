{
  "/public/**": {
    "target": "https://localhost:8443",
    "secure": false,
    "pathRewrite": {
      "^/public": "/ui/public"
    },
    "logLevel": "debug",
    "changeOrigin": true
  },
  "/internal/**": {
    "target": "https://localhost:8443",
    "secure": false,
    "pathRewrite": {
      "^/internal": "/ui/internal"
    },
    "logLevel": "debug",
    "changeOrigin": true
  },
  "/edit/**": {
    "target": "https://localhost:8443",
    "secure": false,
    "pathRewrite": {
      "^/edit": "/ui/edit"
    },
    "logLevel": "debug",
    "changeOrigin": true
  }
}
